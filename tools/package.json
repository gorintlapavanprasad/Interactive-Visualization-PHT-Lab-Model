{
  "name": "pht-lab-tools",
  "private": true,
  "description": "Data pipeline, audit and automated tests for the PHT Lab dashboard",
  "scripts": {
    "test": "node audit-data.js && node ci-test.js",
    "test:update-golden": "node ci-test.js --update-golden",
    "build-data": "node build-data.js",
    "build-data:check": "node build-data.js --dry-run",
    "audit": "node audit-data.js",
    "test:a11y": "node a11y-persona-test.js http://127.0.0.1:8765/ latest"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "puppeteer-core": "^23.0.0"
  }
}
